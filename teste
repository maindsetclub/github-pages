        const opt=document.createElement('option');opt.value=p;opt.textContent=p;select.appendChild(opt);
      });
      if (cat==='3') document.getElementById('customProcedimentoField').style.display='block';
      if (cat==='5') document.getElementById('adesaoField').style.display='block';
    }

    document.getElementById('categoria').addEventListener('change',populateProcedimentos);
    document.getElementById('procedimento').addEventListener('change',function(){
      const cat=document.getElementById('categoria').value;
      const proc=this.value;
      document.getElementById('customProcedimentoField').style.display=(cat==='1'&&proc==='Geral')||cat==='3'?'block':'none';
    });

    function clearErrors(){document.querySelectorAll('.error').forEach(e=>e.classList.add('hidden'));}
    function validateFields(fields){let ok=true;fields.forEach(id=>{const el=document.getElementById(id);if(!el.value.trim()){document.getElementById(`error-${id}`).classList.remove('hidden');ok=false;}});return ok;}

function generateEmail(){
  clearErrors();
  const cat = document.getElementById('categoria').value;
  // Campos obrigatórios dinâmicos
  const required = ['protocoloAbertura','nomeBeneficiario','dataSolicitacao','categoria','procedimento'];
  if(cat !== '7') required.push('protocoloSolicitacao');
  if(!validateFields(required)) return;

  const proc = document.getElementById('procedimento').value;
  const custom = document.getElementById('customProcedimento').value;
  const adesaoRaw = document.getElementById('dataAdesao').value;
  const hoje = new Date();
  const dataHoje = hoje.toLocaleDateString('pt-BR');
  let diffDias = '', diffExtenso = '';
  if(adesaoRaw){
    const parts = adesaoRaw.split('-');
    const d = new Date(parts[0], parts[1]-1, parts[2]);
    const ms = hoje - d;
    diffDias = Math.floor(ms/86400000);
    diffExtenso = numberToWords(diffDias);
  }

  // Seleciona o template, ou usa fallback
  let template = (emailTemplates[cat] && emailTemplates[cat][proc]);
  if(!template){
    template =
`Olá {{nomeBeneficiario}},
Protocolo: {{protocoloAbertura}}${cat !== '7' ? '\\nProtocolo Solicitação: {{protocoloSolicitacao}}' : ''}
Procedimento: {{procedimento}}
Procedimento Manual: {{customProcedimento}}
Data Adesão: {{dataAdesao}}
Data Hoje: {{dataHoje}}
Dias desde Adesão: {{diffDias}} ({{diffExtenso}})`;
  }

  const reps = {
    protocoloAbertura: document.getElementById('protocoloAbertura').value,
    nomeBeneficiario: document.getElementById('nomeBeneficiario').value,
    procedimento: proc,
    customProcedimento: custom,
    dataAdesao: adesaoRaw? adesaoRaw.split('-').reverse().join('/') : '',
    dataHoje: dataHoje,
    diffDias: diffDias,
    diffExtenso: diffExtenso,
    dataSolicitacao: document.getElementById('dataSolicitacao').value.split('-').reverse().join('/'),
    protocoloSolicitacao: document.getElementById('protocoloSolicitacao').value
  };
  Object.entries(reps).forEach(([k,v])=>{
    template = template.replace(new RegExp(`{{${k}}}`,'g'), v);
  });
  document.getElementById('result').value = template;
}
    async function copyToClipboard(){const txt=document.getElementById('result').value;try{await navigator.clipboard.writeText(txt);}catch{document.execCommand('copy');}}
    function clearForm(){document.querySelectorAll('input,select').forEach(e=>e.value='');document.getElementById('procedimento').innerHTML='<option value="">-- Selecione o procedimento --</option>';document.getElementById('customProcedimentoField').style.display='none';document.getElementById('adesaoField').style.display='none';clearErrors();document.getElementById('result').value='';}
    window.onload=clearForm;
  </script>
